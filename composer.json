{
    "name": "webtack/e-cms",
    "type": "library",
    "description": "A multilingual content management system with an Inertia admin panel and a theme system for Laravel.",
    "keywords": [
        "laravel",
        "cms",
        "inertia",
        "admin"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ruslan Bilyshko"
        }
    ],
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.5",
        "intervention/image": "^4.4",
        "laravel/framework": "^13.17",
        "symfony/html-sanitizer": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Webtack\\Ecms\\": "src/",
            "Webtack\\Ecms\\Database\\Factories\\": "database/factories/",
            "Webtack\\Ecms\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webtack\\Ecms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webtack\\Ecms\\EcmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test"
    }
}
